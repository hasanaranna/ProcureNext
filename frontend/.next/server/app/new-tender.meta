{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/new-tender/layout,_N_T_/new-tender/page,_N_T_/new-tender"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/new-tender/__PAGE__",
    "/new-tender",
    "/_index",
    "/_head"
  ]
}